{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=sales_system;Username=sales_app"
  },
  "Database": {
    "Provider": "PostgreSql",
    "ApplyMigrationsOnStartup": true
  },
  "Jwt": {
    "Issuer": "SalesSystem",
    "Audience": "SalesSystem.Client",
    "Key": "",
    "ExpiryMinutes": 480
  },
  "App": {
    "TimeZone": "Asia/Riyadh",
    "Currency": "ر.س",
    "CompanyName": "نظام إدارة المبيعات",
    "CorsOrigins": [ "http://localhost:5173" ]
  },
  "Storage": {
    "UploadsPath": "App_Data/uploads",
    "MaxFileBytes": 5242880
  },
  "Seed": {
    "AdminUsername": "admin",
    "AdminFullName": "المدير العام",
    "AdminPassword": ""
  },
  "Security": {
    "LoginAttemptsPerMinute": 10
  }
}
