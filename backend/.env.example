# Environment variables for the API (production / containers). Never commit real values.
# ASP.NET Core maps "__" to ":" (Jwt__Key -> Jwt:Key).

ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__Default=Host=YOUR_PG_HOST;Port=5432;Database=sales_system;Username=sales_app;Password=YOUR_PASSWORD;SSL Mode=Prefer
Jwt__Key=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
Jwt__ExpiryMinutes=480
Seed__AdminUsername=admin
Seed__AdminPassword=REPLACE_WITH_INITIAL_ADMIN_PASSWORD
App__CorsOrigins__0=https://your-frontend-domain.example
Storage__UploadsPath=/var/app/uploads
Database__ApplyMigrationsOnStartup=true
